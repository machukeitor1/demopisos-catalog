# JWT secret para autenticación de admin y vendedores
# Genera uno con: openssl rand -base64 32
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio

# Base de datos PostgreSQL (Neon, Supabase, Render, local...)
# Ejemplo local: postgresql://postgres:postgres@localhost:5432/demopisos
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db
